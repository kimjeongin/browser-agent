# Browser Agent - Environment Configuration
# Copy this file to .env and fill in your values
# WARNING: Change ALL default passwords before deploying to production!

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_DB=browser_agent
POSTGRES_USER=browser_agent
# WARNING: Change this password in production!
POSTGRES_PASSWORD=change_me_in_production

# ============================================================
# MinIO (S3-compatible object storage)
# ============================================================
MINIO_ROOT_USER=minioadmin
# WARNING: Change this password in production!
MINIO_ROOT_PASSWORD=change_me_in_production

# ============================================================
# Keycloak (Identity Provider)
# ============================================================
KC_BOOTSTRAP_ADMIN_USER=admin
# WARNING: Change this password in production!
KC_BOOTSTRAP_ADMIN_PASSWORD=change_me_in_production

# ============================================================
# CORS Configuration
# ============================================================
# Comma-separated list of allowed origins, or * for all
# WARNING: Do not use * in production!
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# Ollama (LLM)
# ============================================================
OLLAMA_BASE_URL=http://host.docker.internal:11434

{
  "realm": "browser-agent",
  "displayName": "Browser Agent",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "browser-agent-extension",
      "name": "Browser Agent Extension",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "roles": [
        {
          "name": "active",
          "description": "Active user — allowed to access the service"
        }
      ],
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "browser-agent-extension",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "active-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "active",
            "claim.name": "active",
            "jsonType.label": "boolean",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "redirectUris": [
        "https://*/*",
        "http://localhost/*",
        "chrome-extension://*/*",
        "moz-extension://*/*",
        "https://dfobhjajeiofnnfheejaejfbjncmadjj.chromiumapp.org/*"
      ],
      "webOrigins": ["*","https://dfobhjajeiofnnfheejaejfbjncmadjj.chromiumapp.org"],
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    }
  ],
  "users": [
    {
      "username": "testuser",
      "email": "test@example.com",
      "firstName": "Test",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "attributes": {
        "active": ["true"]
      },
      "clientRoles": {
        "browser-agent-extension": ["active"]
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Regular user"
      }
    ]
  },
  "defaultRoles": ["offline_access", "uma_authorization", "user"]
}

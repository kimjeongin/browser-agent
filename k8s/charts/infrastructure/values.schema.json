{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Browser Agent Infrastructure Chart Values",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "namespace":    { "type": "string" },
        "storageClass": { "type": "string" }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository":  { "type": "string" },
            "tag":         { "type": "string" },
            "pullPolicy":  { "type": "string" }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" },
            "database":       { "type": "string" },
            "username":       { "type": "string" }
          },
          "required": ["existingSecret"]
        },
        "persistence": {
          "type": "object",
          "properties": { "size": { "type": "string" } }
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "keycloak": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" },
            "adminUser":      { "type": "string" }
          },
          "required": ["existingSecret"]
        }
      }
    },
    "minio": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" }
          },
          "required": ["existingSecret"]
        }
      }
    }
  }
}
